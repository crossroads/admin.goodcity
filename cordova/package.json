{
  "name": "hk.goodcity.adminstaging",
  "version": "0.21.1",
  "displayName": "S. Admin GoodCity",
  "dependencies": {
    "cordova": "^13.0.0"
  },
  "devDependencies": {
    "@havesource/cordova-plugin-push": "^7.0.0",
    "@steveyken/cordova-plugin-twiliovoicesdk": "github:steveyken/cordova-plugin-twiliovoicesdk#9422dd8d645ec50d4db2fecbb0920a073ad28c99",
    "cordova-android": "^15.1.0",
    "cordova-ios": "^8.1.1",
    "cordova-plugin-actionsheet": "^2.3.3",
    "cordova-plugin-android-permissions": "^1.1.5",
    "cordova-plugin-camera": "^8.0.0",
    "cordova-plugin-device": "^3.0.0",
    "cordova-plugin-inappbrowser": "^7.0.0",
    "cordova-plugin-network-information": "^3.1.0",
    "es6-promise-plugin": "^4.2.2",
    "phonegap-plugin-barcodescanner": "github:ochakov/phonegap-plugin-barcodescanner#aaa27a368a57f06d4d1f2922b9758f6970c3338b"
  },
  "cordova": {
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": {
      "cordova-plugin-android-permissions": {},
      "cordova-plugin-device": {},
      "@steveyken/cordova-plugin-twiliovoicesdk": {
        "INCOMING_CALL_APP_NAME": "GoodCity.HK",
        "MASK_INCOMING_PHONE_NUMBER": "true",
        "ENABLE_CALL_KIT": "false"
      },
      "cordova-plugin-actionsheet": {},
      "cordova-plugin-camera": {
        "ANDROIDX_CORE_VERSION": "1.16.+"
      },
      "cordova-plugin-inappbrowser": {},
      "cordova-plugin-network-information": {},
      "es6-promise-plugin": {},
      "@havesource/cordova-plugin-push": {
        "ANDROIDX_CORE_VERSION": "1.16.+",
        "FCM_VERSION": "24.+",
        "IOS_FIREBASE_MESSAGING_VERSION": "10.24.0"
      },
      "phonegap-plugin-barcodescanner": {
        "ANDROID_SUPPORT_V4_VERSION": "27.+"
      }
    }
  }
}
